<Window x:Class="TicTacToeWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Крестики-нолики"
        Width="1072"
        SizeToContent="Height"
        MinHeight="480"
        Background="#FFFAFAFA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Эффект лёгкой тени -->
        <DropShadowEffect x:Key="DropShadow" Color="Black" Opacity="0.2" BlurRadius="6" Direction="270" ShadowDepth="2"/>

        <!-- Общий стиль закруглённых кнопок -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource DropShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Вход за крестики -->
        <Border Grid.Column="0" Background="#FFF1F8E9" CornerRadius="10" Padding="20" Margin="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" Direction="270" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Игрок X" FontSize="20" FontWeight="Bold" Foreground="#FF0D47A1" Margin="0,0,0,10" TextAlignment="Center"/>
                <Button Content="Войти за Крестики" Width="160" Height="40" Background="#FF42A5F5" Foreground="White" Style="{StaticResource RoundedButtonStyle}" Click="LoginX_Click"/>
            </StackPanel>
        </Border>

        <!-- Центр: выбор режима, таблица и кнопка отчёта -->
        <Border Grid.Column="1" Background="#FFF0F4FA" CornerRadius="10" Padding="20" Margin="10" BorderBrush="#FFBDBDBD" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock Text="Выбери режим игры" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" TextAlignment="Center"/>
                    <UniformGrid Columns="4" HorizontalAlignment="Center" Margin="0,0,0,20" Rows="1">
                        <Button Content="3x3" Width="70" Height="35" Margin="5" Background="#FF64B5F6" Foreground="Black" Style="{StaticResource RoundedButtonStyle}" Click="Start3x3_Click"/>
                        <Button Content="6x6" Width="70" Height="35" Margin="5" Background="#FF4DB6AC" Foreground="Black" Style="{StaticResource RoundedButtonStyle}" Click="Start6x6_Click"/>
                        <Button Content="9x9" Width="70" Height="35" Margin="5" Background="#FFFFF176" Foreground="Black" Style="{StaticResource RoundedButtonStyle}" Click="Start9x9_Click"/>
                        <Button Content="11x11" Width="70" Height="35" Margin="5" Background="#FFFFAB91" Foreground="Black" Style="{StaticResource RoundedButtonStyle}" Click="Start11x11_Click"/>
                    </UniformGrid>

                    <TextBlock Text="Таблица лидеров" FontSize="18" FontWeight="SemiBold" Margin="0,10"/>
                    <ListView x:Name="LeaderboardList" Height="158" Width="320" BorderBrush="#FFCFD8DC" BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ранг" Width="50" DisplayMemberBinding="{Binding Rank}"/>
                                <GridViewColumn Header="Игрок" Width="140" DisplayMemberBinding="{Binding Username}"/>
                                <GridViewColumn Header="Очки" Width="80" DisplayMemberBinding="{Binding Score}"/>
                            </GridView>
                        </ListView.View>

                    </ListView>

                    <Button Content="Сгенерировать отчёт"
                            Width="200" Height="40" Margin="0,10,0,0"
                            Background="#FF1E88E5" Foreground="White"
                            Style="{StaticResource RoundedButtonStyle}"
                            Click="GenerateReport_Click"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Вход за нолики -->
        <Border Grid.Column="2" Background="#FFF1F8E9" CornerRadius="10" Padding="20" Margin="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" Direction="270" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Игрок O" FontSize="20" FontWeight="Bold" Foreground="#FF33691E" Margin="0,0,0,10" TextAlignment="Center"/>
                <Button Content="Войти за Нолики" Width="160" Height="40" Background="#FF8BC34A" Foreground="White" Style="{StaticResource RoundedButtonStyle}" Click="LoginO_Click"/>
            </StackPanel>
        </Border>

        <!-- Кнопка выхода -->
        <Button Content="Выход"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="100" Height="35" Margin="0,0,10,10"
                Background="#FFEF5350" Foreground="White"
                Style="{StaticResource RoundedButtonStyle}"
                Click="Exit_Click"/>

        <!-- Метки игроков -->
        <TextBlock x:Name="PlayerXLabel" Text="Игрок X: не вошёл" 
                   FontSize="14" FontWeight="SemiBold" Foreground="#FF0D47A1" 
                   HorizontalAlignment="Center" Margin="0,10,0,0" Height="28" VerticalAlignment="Top"/>
        <TextBlock x:Name="PlayerOLabel" Grid.Column="2" Text="Игрок O: не вошёл" 
                   FontSize="14" FontWeight="SemiBold" Foreground="#FF33691E" 
                   HorizontalAlignment="Center" Margin="0,10,0,386"/>
    </Grid>
</Window>
