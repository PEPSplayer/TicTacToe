<Window x:Class="TicTacToeWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="400" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#f0f0f0">
    <Border CornerRadius="10" Background="White" Padding="20" Margin="10" BorderBrush="#cccccc" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Добро пожаловать!" FontSize="20" FontWeight="Bold" Foreground="#333" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин" FontWeight="SemiBold" Foreground="#666"/>
            <TextBox x:Name="LoginBox" Height="35" Margin="0,5,0,10" FontSize="14" BorderBrush="#aaa" BorderThickness="1"/>

            <TextBlock Text="Пароль" FontWeight="SemiBold" Foreground="#666"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Margin="0,5,0,20" FontSize="14" BorderBrush="#aaa" BorderThickness="1"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="Войти" Width="120" Height="35" Margin="5"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="Login_Click"/>
                <Button Content="Регистрация" Width="120" Height="35" Margin="5"
                        Background="#2196F3" Foreground="White" FontWeight="Bold" Click="Register_Click"/>
            </StackPanel>

            <TextBlock x:Name="MessageBlock" TextAlignment="Center" Foreground="Red" FontSize="13"/>
        </StackPanel>
    </Border>
</Window>
